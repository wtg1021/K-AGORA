{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "K-AGORA: 협의체 실제 자료 37건",
      "type": "debugpy",
      "request": "launch",
      "module": "agora.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "8000",
        "DATABASE_PATH": "${workspaceFolder}/data/school-accounting-2026-02.sqlite3",
        "SEED_DEMO": "true",
        "ADMIN_TOKEN": "${input:adminToken}",
        "SEED_DATA_PATH": "${workspaceFolder}/documents/2026-school-accounting-02/01-agendas-master-37.json"
      },
      "args": [
        "--real"
      ]
    },
    {
      "name": "K-AGORA: 테스트 전용 (예시 8건)",
      "type": "debugpy",
      "request": "launch",
      "module": "agora.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "8000",
        "DATABASE_PATH": "${workspaceFolder}/data/agora.sqlite3",
        "SEED_DEMO": "true",
        "ADMIN_TOKEN": "",
        "SEED_DATA_PATH": "${workspaceFolder}/data/sample-agendas.json"
      },
      "args": [
        "--demo"
      ]
    },
    {
      "name": "K-AGORA: 관리자 모드",
      "type": "debugpy",
      "request": "launch",
      "module": "agora.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "8000",
        "DATABASE_PATH": "${workspaceFolder}/data/school-accounting-2026-02.sqlite3",
        "SEED_DEMO": "true",
        "ADMIN_TOKEN": "${input:adminToken}"
      },
      "args": [
        "--real"
      ]
    },
    {
      "name": "K-AGORA: 실제 자료용 빈 DB",
      "type": "debugpy",
      "request": "launch",
      "module": "agora.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "HOST": "127.0.0.1",
        "PORT": "8000",
        "DATABASE_PATH": "${workspaceFolder}/data/local-agendas.sqlite3",
        "SEED_DEMO": "false",
        "ADMIN_TOKEN": "${input:adminToken}"
      }
    }
  ],
  "inputs": [
    {
      "id": "adminToken",
      "type": "promptString",
      "description": "사용할 관리자 키를 입력하세요. 브라우저 관리 화면에도 같은 키를 입력합니다.",
      "password": true
    }
  ]
}
